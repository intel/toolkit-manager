pipeline {
    agent {
        kubernetes {
            inheritFrom 'proxy'
            defaultContainer 'agent'
            yaml '''
apiVersion: v1
kind: Pod
spec:
  volumes:
    - name: validation-tools
      emptyDir:
        sizeLimit: 128Mi
  initContainers:
    - name: validation-helm
      image: alpine/helm:3.20.2@sha256:0dc15c3084f75cdf39823f63efbe7c21084d2dbffefce2637effc1b093485d81
      command: ['/bin/sh', '-ec']
      args:
        - 'cp "$(command -v helm)" /validation-tools/helm; chmod 0555 /validation-tools/helm'
      securityContext:
        runAsUser: 0
        allowPrivilegeEscalation: false
        readOnlyRootFilesystem: true
        capabilities:
          drop: ['ALL']
      volumeMounts:
        - name: validation-tools
          mountPath: /validation-tools
    - name: validation-yq
      image: mikefarah/yq:4.53.2@sha256:0cb4a78491b6e62ee8a9bf4fbeacbd15b5013d19bc420591b05383a696315e60
      command: ['/bin/sh', '-ec']
      args:
        - 'cp "$(command -v yq)" /validation-tools/yq; chmod 0555 /validation-tools/yq'
      securityContext:
        runAsUser: 0
        allowPrivilegeEscalation: false
        readOnlyRootFilesystem: true
        capabilities:
          drop: ['ALL']
      volumeMounts:
        - name: validation-tools
          mountPath: /validation-tools
  containers:
    - name: agent
      image: ger-is-registry.caas.intel.com/nwcsp/jenkins-agent-docker:3.6
      command: ['cat']
      tty: true
    - name: renovate
      image: renovate/renovate:44.257.9
      command: ['cat']
      tty: true
      securityContext:
        runAsUser: 1000
        runAsGroup: 1000
        runAsNonRoot: true
      env:
        - name: HOME
          value: /tmp/renovate
        - name: XDG_CONFIG_HOME
          value: /tmp/renovate/.config
      volumeMounts:
        - name: validation-tools
          mountPath: /validation-tools
          readOnly: true
'''
        }
    }

    options {
        disableConcurrentBuilds()
        timeout(time: 90, unit: 'MINUTES')
        timestamps()
    }

    triggers {
        cron('TZ=UTC\nH 2 * * 1')
    }

    parameters {
        booleanParam(
            name: 'VALIDATE_REDIS_FIX',
            defaultValue: false,
            description: 'Validate upstream candidates on the exact unmerged Redis metadata fix; no PR creation or deployment'
        )
        string(
            name: 'REPOSITORIES',
            defaultValue: 'intel/agent-toolkit',
            description: 'Comma-separated GitHub repositories with bot access'
        )
        booleanParam(
            name: 'CREATE_PRS',
            defaultValue: false,
            description: 'Create or update the approved Agent Sandbox pilot PR after a successful scoped dry run'
        )
        booleanParam(
            name: 'VERIFY_PR_CREDENTIAL',
            defaultValue: false,
            description: 'Read-only check of the PR credential account and configured Agent Toolkit fork'
        )
        booleanParam(
            name: 'PILOT_DRY_RUN',
            defaultValue: false,
            description: 'Dry-run only the selected Agent Sandbox patch proposal'
        )
    }

    environment {
        RENOVATE_PLATFORM = 'github'
        LOG_FORMAT = 'json'
        LOG_LEVEL = 'info'
        HTTPS_PROXY = 'http://proxy-dmz.intel.com:912'
        https_proxy = 'http://proxy-dmz.intel.com:912'
    }

    stages {
        stage('Prepare discovery') {
            steps {
                script {
                    if (params.VALIDATE_REDIS_FIX &&
                        (params.REPOSITORIES != 'intel/agent-toolkit' || params.CREATE_PRS ||
                         params.PILOT_DRY_RUN || params.VERIFY_PR_CREDENTIAL)) {
                        error('Redis fix validation requires only intel/agent-toolkit and all PR/pilot/credential flags disabled.')
                    }
                    if ((params.PILOT_DRY_RUN || params.CREATE_PRS) && params.REPOSITORIES != 'intel/agent-toolkit') {
                        error('The Agent Sandbox pilot requires REPOSITORIES=intel/agent-toolkit.')
                    }
                    if (!(params.REPOSITORIES ==~ /[A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+(,[A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+)*/)) {
                        error('REPOSITORIES must be a comma-separated list of GitHub owner/repository names without spaces.')
                    }
                }
                sh '''#!/usr/bin/env bash
                    set -euo pipefail
                    echo "WARNING: Renovate Dependabot alert integration is disabled; this run does not check GitHub vulnerability alerts."
                    echo "Jenkins agent identity:"
                    id
                    echo "Workspace ownership and permissions (numeric uid:gid mode path):"
                    stat -c '%u:%g %a %n' "$WORKSPACE" "${WORKSPACE}@tmp"
                    rm -f -- stable-discovery.jsonl stable-pull-requests.jsonl stable-pilot.jsonl stable-inventory.tsv stable-components.json stable-components.tsv stable-upgrade-matrix.json stable-upgrade-matrix.tsv stable-static-validation.json
                '''
                container('renovate') {
                    sh '''#!/usr/bin/env bash
                        set -euo pipefail
                        export PATH="/validation-tools:$PATH"
                        node -e "require('./ci/validate-toolkit-config.cjs').checkTools(process.cwd()).forEach(tool => console.log(tool.command + ': ' + tool.stdout.trim()))"
                    '''
                }
            }
        }

        stage('Identify toolkit upstream stable releases') {
            when { expression { params.REPOSITORIES.split(',').contains('intel/agent-toolkit') } }
            steps {
                container('renovate') {
                    withCredentials([string(credentialsId: 'renovate-github-token', variable: 'RENOVATE_TOKEN')]) {
                        sh '''#!/usr/bin/env bash
                            set -euo pipefail
                            set +x
                            node ci/discover-toolkit-releases.cjs ci/toolkit-components.json stable-components
                        '''
                    }
                }
            }
        }

        stage('Identify stable versions') {
            steps {
                container('renovate') {
                    sh '''#!/usr/bin/env bash
                        set -euo pipefail
                        echo "Renovate container identity:"
                        id
                        test -w "$WORKSPACE"
                        test -w "${WORKSPACE}@tmp"
                        echo "Renovate can write to the shared workspace and temporary directory."
                    '''
                    withCredentials([string(credentialsId: 'renovate-github-token', variable: 'RENOVATE_TOKEN')]) {
                        withEnv(["RENOVATE_REPOSITORIES=${params.REPOSITORIES}", "RENOVATE_CONFIG_FILE=${env.WORKSPACE}/ci/renovate-config.json", 'RENOVATE_DRY_RUN=full']) {
                            sh '''#!/usr/bin/env bash
                                set -euo pipefail
                                set +x
                                renovate | tee stable-discovery.jsonl
                                if grep -Fq 'Cannot access vulnerability alerts.' stable-discovery.jsonl; then
                                    if ! bash ci/check-github-alert-access.sh; then
                                        echo "Alert access diagnostic could not complete; inspect the error above." >&2
                                    fi
                                fi
                            '''
                        }
                    }
                }
                withEnv(["RENOVATE_REPOSITORIES=${params.REPOSITORIES}"]) {
                    sh '''#!/usr/bin/env bash
                        set -euo pipefail
                        bash ci/summarize-renovate-report.sh stable-discovery.jsonl stable-inventory.tsv
                        bash ci/check-renovate-report.sh stable-discovery.jsonl
                    '''
                }
            }
        }

        stage('Build upgrade matrix') {
            when { expression { params.REPOSITORIES.split(',').contains('intel/agent-toolkit') } }
            steps {
                container('renovate') {
                    sh '''#!/usr/bin/env bash
                        set -euo pipefail
                        node ci/make-upgrade-matrix.cjs stable-components.json stable-discovery.jsonl stable-upgrade-matrix
                    '''
                }
            }
        }

        stage('Static configuration validation') {
            when { expression { params.REPOSITORIES.split(',').contains('intel/agent-toolkit') } }
            steps {
                container('renovate') {
                    withEnv(["VALIDATE_REDIS_FIX=${params.VALIDATE_REDIS_FIX}"]) {
                    sh '''#!/usr/bin/env bash
                        set -euo pipefail
                        export PATH="/validation-tools:$PATH"
                        source_commit=$(node -p "require('./stable-components.json').sourceCommit")
                        [[ "$source_commit" =~ ^[a-f0-9]{40}$ ]]
                        source_dir=$(mktemp -d)
                        trap 'rm -rf -- "$source_dir"' EXIT
                        git -C "$source_dir" init --quiet
                        if [[ "$VALIDATE_REDIS_FIX" == "true" ]]; then
                            echo "OPT-IN: validating unmerged fork commit ea16d845a200f125be85b9630660472f7e52fa66, not upstream main."
                            git -C "$source_dir" fetch --quiet --depth 2 https://github.com/nishi252003/enterprise-agent-toolkit.git ea16d845a200f125be85b9630660472f7e52fa66
                        else
                            git -C "$source_dir" fetch --quiet --depth 1 https://github.com/intel/agent-toolkit.git "$source_commit"
                        fi
                        git -C "$source_dir" checkout --quiet --detach FETCH_HEAD
                        node ci/validate-toolkit-config.cjs "$source_dir" stable-upgrade-matrix.json stable-upgrade-matrix stable-static-validation.json
                    '''
                    }
                }
            }
        }

        stage('Agent Sandbox pilot dry run') {
            when { expression { params.PILOT_DRY_RUN || params.CREATE_PRS } }
            steps {
                sh '''#!/usr/bin/env bash
                    set -euo pipefail
                    bash ci/make-pilot-config.sh ci/renovate-config.json stable-pilot-config.json
                '''
                container('renovate') {
                    withCredentials([string(credentialsId: 'renovate-github-token', variable: 'RENOVATE_TOKEN')]) {
                        withEnv(['RENOVATE_REPOSITORIES=intel/agent-toolkit', "RENOVATE_CONFIG_FILE=${env.WORKSPACE}/stable-pilot-config.json", 'RENOVATE_DRY_RUN=full']) {
                            sh '''#!/usr/bin/env bash
                                set -euo pipefail
                                set +x
                                renovate | tee stable-pilot.jsonl
                            '''
                        }
                    }
                }
                withEnv(['RENOVATE_REPOSITORIES=intel/agent-toolkit']) {
                    sh '''#!/usr/bin/env bash
                        set -euo pipefail
                        bash ci/check-renovate-report.sh stable-pilot.jsonl
                        bash ci/check-pilot-report.sh stable-pilot.jsonl
                    '''
                }
            }
        }

        stage('Verify PR credential') {
            when { expression { params.VERIFY_PR_CREDENTIAL || params.CREATE_PRS } }
            steps {
                container('renovate') {
                    withCredentials([usernamePassword(credentialsId: 'validation-agent-github-pat', usernameVariable: 'GITHUB_USERNAME', passwordVariable: 'RENOVATE_TOKEN')]) {
                        sh '''#!/usr/bin/env bash
                            set -euo pipefail
                            set +x
                            bash ci/check-pr-credential.sh
                        '''
                    }
                }
            }
        }

        stage('Create Agent Sandbox pilot PR') {
            when { expression { params.CREATE_PRS } }
            steps {
                container('renovate') {
                    withCredentials([usernamePassword(credentialsId: 'validation-agent-github-pat', usernameVariable: 'GITHUB_USERNAME', passwordVariable: 'RENOVATE_TOKEN')]) {
                        withEnv(['RENOVATE_REPOSITORIES=intel/agent-toolkit', "RENOVATE_CONFIG_FILE=${env.WORKSPACE}/stable-pilot-config.json", 'RENOVATE_DRY_RUN=']) {
                            sh '''#!/usr/bin/env bash
                                set -euo pipefail
                                set +x
                                export RENOVATE_FORK_TOKEN="$RENOVATE_TOKEN"
                                renovate | tee stable-pull-requests.jsonl
                                bash ci/check-pilot-pr.sh
                            '''
                        }
                    }
                }
                withEnv(['RENOVATE_REPOSITORIES=intel/agent-toolkit']) {
                    sh '''#!/usr/bin/env bash
                        set -euo pipefail
                        bash ci/check-renovate-report.sh stable-pull-requests.jsonl
                        bash ci/check-pilot-report.sh stable-pull-requests.jsonl
                    '''
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'stable-*.jsonl,stable-*.tsv,stable-components.json,stable-upgrade-matrix.json,stable-static-validation.json', allowEmptyArchive: true
        }
    }
}
