pipeline {
    agent {
        kubernetes {
            inheritFrom 'proxy'
            defaultContainer 'agent'
            yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
    - name: agent
      image: ger-is-registry.caas.intel.com/nwcsp/jenkins-agent-docker:3.6
      command: ['cat']
      tty: true
    - name: renovate
      image: renovate/renovate:44.257.9
      command: ['cat']
      tty: true
      securityContext:
        runAsUser: 1000
        runAsGroup: 1000
        runAsNonRoot: true
      env:
        - name: HOME
          value: /tmp/renovate
'''
        }
    }

    options {
        disableConcurrentBuilds()
        timeout(time: 90, unit: 'MINUTES')
        timestamps()
    }

    triggers {
        cron('TZ=UTC\nH 2 * * 1')
    }

    parameters {
        string(
            name: 'REPOSITORIES',
            defaultValue: 'intel/agent-toolkit',
            description: 'Comma-separated GitHub repositories with bot access'
        )
        booleanParam(
            name: 'CREATE_PRS',
            defaultValue: false,
            description: 'Create or update the approved Agent Sandbox pilot PR after a successful scoped dry run'
        )
        booleanParam(
            name: 'VERIFY_PR_CREDENTIAL',
            defaultValue: false,
            description: 'Read-only check of the PR credential account and configured Agent Toolkit fork'
        )
        booleanParam(
            name: 'PILOT_DRY_RUN',
            defaultValue: false,
            description: 'Dry-run only the selected Agent Sandbox patch proposal'
        )
    }

    environment {
        RENOVATE_PLATFORM = 'github'
        LOG_FORMAT = 'json'
        LOG_LEVEL = 'info'
        HTTPS_PROXY = 'http://proxy-dmz.intel.com:912'
        https_proxy = 'http://proxy-dmz.intel.com:912'
    }

    stages {
        stage('Identify stable versions') {
            steps {
                script {
                    if ((params.PILOT_DRY_RUN || params.CREATE_PRS) && params.REPOSITORIES != 'intel/agent-toolkit') {
                        error('The Agent Sandbox pilot requires REPOSITORIES=intel/agent-toolkit.')
                    }
                    if (!(params.REPOSITORIES ==~ /[A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+(,[A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+)*/)) {
                        error('REPOSITORIES must be a comma-separated list of GitHub owner/repository names without spaces.')
                    }
                }
                sh '''#!/usr/bin/env bash
                    set -euo pipefail
                    echo "WARNING: Renovate Dependabot alert integration is disabled; this run does not check GitHub vulnerability alerts."
                    echo "Jenkins agent identity:"
                    id
                    echo "Workspace ownership and permissions (numeric uid:gid mode path):"
                    stat -c '%u:%g %a %n' "$WORKSPACE" "${WORKSPACE}@tmp"
                    rm -f -- stable-discovery.jsonl stable-pull-requests.jsonl stable-pilot.jsonl
                '''
                container('renovate') {
                    sh '''#!/usr/bin/env bash
                        set -euo pipefail
                        echo "Renovate container identity:"
                        id
                        test -w "$WORKSPACE"
                        test -w "${WORKSPACE}@tmp"
                        echo "Renovate can write to the shared workspace and temporary directory."
                    '''
                    withCredentials([string(credentialsId: 'renovate-github-token', variable: 'RENOVATE_TOKEN')]) {
                        withEnv(["RENOVATE_REPOSITORIES=${params.REPOSITORIES}", "RENOVATE_CONFIG_FILE=${env.WORKSPACE}/ci/renovate-config.json", 'RENOVATE_DRY_RUN=full']) {
                            sh '''#!/usr/bin/env bash
                                set -euo pipefail
                                set +x
                                renovate | tee stable-discovery.jsonl
                                if grep -Fq 'Cannot access vulnerability alerts.' stable-discovery.jsonl; then
                                    if ! bash ci/check-github-alert-access.sh; then
                                        echo "Alert access diagnostic could not complete; inspect the error above." >&2
                                    fi
                                fi
                            '''
                        }
                    }
                }
                withEnv(["RENOVATE_REPOSITORIES=${params.REPOSITORIES}"]) {
                    sh 'bash ci/check-renovate-report.sh stable-discovery.jsonl'
                }
            }
        }

        stage('Agent Sandbox pilot dry run') {
            when { expression { params.PILOT_DRY_RUN || params.CREATE_PRS } }
            steps {
                sh '''#!/usr/bin/env bash
                    set -euo pipefail
                    bash ci/make-pilot-config.sh ci/renovate-config.json stable-pilot-config.json
                '''
                container('renovate') {
                    withCredentials([string(credentialsId: 'renovate-github-token', variable: 'RENOVATE_TOKEN')]) {
                        withEnv(['RENOVATE_REPOSITORIES=intel/agent-toolkit', "RENOVATE_CONFIG_FILE=${env.WORKSPACE}/stable-pilot-config.json", 'RENOVATE_DRY_RUN=full']) {
                            sh '''#!/usr/bin/env bash
                                set -euo pipefail
                                set +x
                                renovate | tee stable-pilot.jsonl
                            '''
                        }
                    }
                }
                withEnv(['RENOVATE_REPOSITORIES=intel/agent-toolkit']) {
                    sh '''#!/usr/bin/env bash
                        set -euo pipefail
                        bash ci/check-renovate-report.sh stable-pilot.jsonl
                        bash ci/check-pilot-report.sh stable-pilot.jsonl
                    '''
                }
            }
        }

        stage('Verify PR credential') {
            when { expression { params.VERIFY_PR_CREDENTIAL || params.CREATE_PRS } }
            steps {
                container('renovate') {
                    withCredentials([usernamePassword(credentialsId: 'validation-agent-github-pat', usernameVariable: 'GITHUB_USERNAME', passwordVariable: 'RENOVATE_TOKEN')]) {
                        sh '''#!/usr/bin/env bash
                            set -euo pipefail
                            set +x
                            bash ci/check-pr-credential.sh
                        '''
                    }
                }
            }
        }

        stage('Create Agent Sandbox pilot PR') {
            when { expression { params.CREATE_PRS } }
            steps {
                container('renovate') {
                    withCredentials([usernamePassword(credentialsId: 'validation-agent-github-pat', usernameVariable: 'GITHUB_USERNAME', passwordVariable: 'RENOVATE_TOKEN')]) {
                        withEnv(['RENOVATE_REPOSITORIES=intel/agent-toolkit', "RENOVATE_CONFIG_FILE=${env.WORKSPACE}/stable-pilot-config.json", 'RENOVATE_DRY_RUN=']) {
                            sh '''#!/usr/bin/env bash
                                set -euo pipefail
                                set +x
                                export RENOVATE_FORK_TOKEN="$RENOVATE_TOKEN"
                                renovate | tee stable-pull-requests.jsonl
                                bash ci/check-pilot-pr.sh
                            '''
                        }
                    }
                }
                withEnv(['RENOVATE_REPOSITORIES=intel/agent-toolkit']) {
                    sh '''#!/usr/bin/env bash
                        set -euo pipefail
                        bash ci/check-renovate-report.sh stable-pull-requests.jsonl
                        bash ci/check-pilot-report.sh stable-pull-requests.jsonl
                    '''
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'stable-*.jsonl', allowEmptyArchive: true
        }
    }
}
